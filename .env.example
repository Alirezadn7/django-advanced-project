DEBUG=True
SECRET_KEY="your-secret-key-here"
ALLOWED_HOSTS=localhost,127.0.0.1
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Bale OTP delivery via Safir v3 "send_message" (bot OTP message) - recommended
BALE_API_ACCESS_KEY=your-bale-api-access-key
BALE_BOT_ID=123456789
# Gateway used for OTP delivery: v3 (send_message) or v2 (OAuth send_otp)
BALE_OTP_GATEWAY=v3

# Bale OTP v2 gateway (legacy OAuth route: client_credentials + /send_otp)
BALE_OTP_CLIENT_ID=your-bale-otp-client-id
BALE_OTP_CLIENT_SECRET=your-bale-otp-client-secret
BALE_OTP_BASE_URL=https://safir.bale.ai/api/v2
BALE_OTP_SCOPE=read

# OTP login tuning
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=120
OTP_PHONE_HOURLY_LIMIT=30
OTP_MAX_ATTEMPTS=5